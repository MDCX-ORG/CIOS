# Copy to .env and edit; .env is gitignored.
CIOS_PG_PASSWORD=changeme
CIOS_GRAFANA_PASSWORD=changeme

# M1 business services (PRMT-026 §4.3).
# CIOS_PG_DSN is consumed by cios-core and cios-alarm inside the
# compose network. The user/password match the postgres service;
# sslmode=disable is fine on the internal bridge (no TLS termination
# in M1; mTLS is pre-prod per spec-006 §5.2).
CIOS_PG_DSN=postgres://cios:${CIOS_PG_PASSWORD}@postgres:5432/cios?sslmode=disable
# Optional: host-side unit tests for PG usage parity (PRMT-195/197).
# From the host (not inside compose), point at published 5432:
#   export CIOS_PG_DSN='postgres://cios:changeme@127.0.0.1:5432/cios?sslmode=disable'
#   go test ./core/ -run UsageStore_PGParity -count=1
# CIOS_SITE is read by cios-edge-writer / cios-rules / cios-alarm to
# filter the NATS subject scope and the VM site label.
CIOS_SITE=site01
# Optional: host override for cios-core Usage NATS sink (compose
# already passes -nats-url=nats://nats:4222). Empty = noop sink.
# CIOS_NATS_URL=nats://127.0.0.1:4222
